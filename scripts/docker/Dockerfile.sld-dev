# syntax=docker/dockerfile:1
# El contexto patch/ contiene sólo los archivos revisados y .theme-sld-revision.
# Conservar la imagen vigente de DEV y cualquier ajuste ajeno al parche.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG THEME_REVISION
# --link agrega una capa sin desempaquetar las numerosas capas de la base.
# La compilación y las pruebas se ejecutan antes, con la misma fuente exportada.
COPY --link patch/ /app/src/ckanext-theme-ejemplo/
LABEL io.ihpwins.theme-sld-revision=$THEME_REVISION
USER ckan
