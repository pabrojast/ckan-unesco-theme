# El contexto patch/ contiene sólo los archivos revisados de esta entrega.
# Conservar la imagen vigente de DEV y cualquier ajuste ajeno al parche.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG THEME_REVISION
USER root
COPY patch/ /app/src/ckanext-theme-ejemplo/
RUN python3 -m compileall -q /app/src/ckanext-theme-ejemplo/ckanext/theme_ejemplo \
    && printf '%s\n' "$THEME_REVISION" > /app/src/ckanext-theme-ejemplo/.theme-sld-revision
LABEL io.ihpwins.theme-sld-revision=$THEME_REVISION
USER ckan
