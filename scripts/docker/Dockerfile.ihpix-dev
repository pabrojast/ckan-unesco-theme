# Construir con una exportación git del commit revisado en theme/.
# La imagen base debe ser el digest vigente en DEV, para conservar otras extensiones.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG THEME_REVISION
USER root
COPY theme/ /app/src/ckanext-theme-ejemplo/
RUN pip install --no-cache-dir 'openpyxl==3.1.5' \
    && python3 -m compileall -q /app/src/ckanext-theme-ejemplo/ckanext/theme_ejemplo \
    && printf '%s\n' "$THEME_REVISION" > /app/src/ckanext-theme-ejemplo/.theme-revision
LABEL io.ihpwins.theme-revision=$THEME_REVISION
USER ckan
