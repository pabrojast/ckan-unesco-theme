rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // profiles/{uid}: community-visible fields or a private profile; owner-editable.
    // privateProfiles/{uid}: optional sentiment/feedback; owner + UNESCO Secretariat only.
    // roles/{uid}: admin:boolean, role:member|core|lead, wgs:list<int>; UNESCO Secretariat writes.
    // preferences/{uid}: followed groups; owner only.
    // opportunities/{id}: activity fields, immutable owner/wg/createdAt; managers set status.
    // contributions/{activityId_uid}: immutable member/task/message; status changes by scope.
    // posts/{id}: denormalised author name, body and group; author creates.
    function signed() { return request.auth != null; }
    function own(uid) { return signed() && request.auth.uid == uid; }
    function roleExists() { return signed() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)); }
    function roleData() { return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data; }
    // IHP-WINS: the owner role (full UNESCO Secretariat access) belongs to the platform administrators of the
    // community, set by CKAN for each request: IHP-WINS sysadmins and the admins of the CKAN group (here 'dacs').
    // It replaces the Firebase version's hard-coded owner email (alexandregermouty@gmail.com).
    function secretariatOwner() { return signed() && request.auth.token.platform_admin == true; }
    function unescoRole() { let r = roleData(); return r.admin == true && r.role == 'unesco-secretariat' && r.get('badges',[]).hasAny(['unesco-secretariat']); }
    function admin() { return secretariatOwner() || (roleExists() && unescoRole()); }
    function groupId(wg) { return wg == 1 ? 'wg1' : wg == 2 ? 'wg2' : wg == 3 ? 'wg3' : wg == 4 ? 'wg4' : 'wg5'; }
    function appointed(wg) {
      let id = groupId(wg);
      return exists(/databases/$(database)/documents/governance/$(id))
        && (get(/databases/$(database)/documents/governance/$(id)).data.lead == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/governance/$(id)).data.secretariat
          || request.auth.uid in get(/databases/$(database)/documents/governance/$(id)).data.associateLeads
          || request.auth.uid in get(/databases/$(database)/documents/governance/$(id)).data.core);
    }
    function manages(wg) { return signed() && (admin() || (roleExists() && wg in roleData().wgs) || appointed(wg)); }
    function validBody(b) { return b in ['wg1','wg2','wg3','wg4','wg5','cfd','alliance','smc','esc','iac']; }
    function bodyWg(b) { return b == 'wg1' ? 1 : b == 'wg2' ? 2 : b == 'wg3' ? 3 : b == 'wg4' ? 4 : b == 'wg5' ? 5 : 0; }
    function bodyAppointment(b,core) {
      let path = /databases/$(database)/documents/governance/$(b);
      return exists(path) && (get(path).data.lead == request.auth.uid || get(path).data.secretariat.hasAny([request.auth.uid])
        || get(path).data.associateLeads.hasAny([request.auth.uid]) || (core && get(path).data.core.hasAny([request.auth.uid])));
    }
    function leadBody(b) { return signed() && validBody(b) && (admin()
      || (roleExists() && (roleData().get('badges',[]).hasAny([b+'-lead',b+'-associate',b+'-secretariat'])
        || (bodyWg(b)>0 && roleData().role in ['lead','associate','secretariat'] && bodyWg(b) in roleData().wgs)))
      || bodyAppointment(b,false)); }
    function coreBody(b) { return leadBody(b) || (signed() && validBody(b) && ((roleExists() && (roleData().get('badges',[]).hasAny([b+'-core'])
      || (bodyWg(b)>0 && roleData().role == 'core' && bodyWg(b) in roleData().wgs))) || bodyAppointment(b,true))); }
    function bodyMember(b) { return coreBody(b) || (signed() && validBody(b) && ((roleExists() && roleData().get('badges',[]).hasAny([b,b+'-member']))
      || (bodyWg(b)>0 && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && bodyWg(b) in get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.wgs))); }
    function meetingAccess(b,t) { return t == 'leadership' ? leadBody(b) : t == 'core' ? coreBody(b) : t == 'broad' && bodyMember(b); }
    function agendaEditor(b,t) { return t == 'leadership' ? leadBody(b) : coreBody(b); }
    // A member has a profile and has not been banned by the UNESCO Secretariat.
    function banned(uid) { return exists(/databases/$(database)/documents/bans/$(uid)); }
    function member() { return signed() && exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) && !banned(request.auth.uid); }
    function string(v,n) { return v is string && v.size() <= n; }
    function validGroups(v) { return v is list && v.size() <= 5 && v.hasOnly([1,2,3,4,5]); }
    function validList(v) {
      let joined = v.join('\n');
      // Equality with the split string list rejects non-string elements and
      // embedded newlines without a 20-element validation expression chain.
      return v is list && v.size() <= 20
        && (v.size() == 0 || (joined.matches('^[^\n]{1,100}(\n[^\n]{1,100}){0,19}$') && v == joined.split('\n')));
    }
    function validSkills(v) { return validList(v); }
    function validLanguages(v) { return validList(v); }
    function validRegion(v) { return v in ['','Africa','Asia and the Pacific','Western Europe and North America','Eastern Europe','Europe and North America','Latin America and the Caribbean','Arab States','Global']; }
    function validGoals(v) { return v is list && v.size()<=15 && v.toSet().size() == v.size() && v.hasOnly(['1.1','1.2','1.3','2.1','2.2','2.3','3.1','3.2','3.3','4.1','4.2','4.3','5.1','5.2','5.3']); }
    function goalsInGroup(v,wg) { return wg == 1 ? v.hasAny(['1.1','1.2','1.3']) : wg == 2 ? v.hasAny(['2.1','2.2','2.3']) : wg == 3 ? v.hasAny(['3.1','3.2','3.3']) : wg == 4 ? v.hasAny(['4.1','4.2','4.3']) : v.hasAny(['5.1','5.2','5.3']); }
    function validTime(v) { return v in ['2–4 hours / month','4–8 hours / month','8+ hours / month','Project-based','Currently unavailable']; }
    function validProfile(d) {
      return d.keys().hasAll(['name','headline','organisation','country','region','languages','skills','wgs','bio','motivation','contribution','availability','website','visibility','contactConsent','contact','consent','createdAt','updatedAt'])
        && d.keys().hasOnly(['name','headline','organisation','country','region','languages','skills','wgs','bio','motivation','contribution','availability','website','visibility','contactConsent','contact','consent','createdAt','updatedAt','careerStage','educationLevel','cryosphereTypes','hasPhoto','onboardingVersion','showBackground','publicGender','publicSentiment'])
        && string(d.name,120) && d.name.size()>0 && string(d.headline,160) && string(d.organisation,160) && string(d.country,100)
        && validRegion(d.region) && validLanguages(d.languages) && validSkills(d.skills) && validGroups(d.wgs)
        && string(d.bio,1500) && string(d.motivation,1500) && string(d.contribution,1500) && validTime(d.availability)
        && string(d.website,500) && d.visibility in ['community','private'] && d.contactConsent is bool
        && ((d.contactConsent && string(d.contact,254) && (d.contact == request.auth.token.email || admin())) || (!d.contactConsent && d.contact == ''))
        && string(d.get('careerStage',''),100) && string(d.get('educationLevel',''),100) && validList(d.get('cryosphereTypes',[]))
        && d.get('hasPhoto',false) is bool && d.get('onboardingVersion',1) in [1,2]
        && d.get('showBackground',false) is bool && string(d.get('publicGender',''),100) && string(d.get('publicSentiment',''),100)
        && (d.get('showBackground',false) == true || (d.get('publicGender','') == '' && d.get('publicSentiment','') == ''))
        && d.consent == true && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function validPrivate(d) { return d.keys().hasAll(['sentiment','feedback','updatedAt']) && d.keys().hasOnly(['sentiment','feedback','updatedAt','gender']) && string(d.sentiment,100) && string(d.feedback,1500) && string(d.get('gender',''),100) && d.updatedAt == request.time; }
    function validRole(d) { return d.keys().hasAll(['admin','role','wgs']) && d.keys().hasOnly(['admin','role','wgs','badges','logoReview']) && d.get('logoReview',[]) is list && d.get('logoReview',[]).size() <= 7 && d.get('logoReview',[]).hasOnly(['wg1','wg2','wg3','wg4','wg5','smc','esc']) && d.admin is bool && d.role in ['member','core','lead','associate','secretariat','unesco-secretariat'] && d.admin == (d.role == 'unesco-secretariat') && d.get('badges',[]).hasAny(['unesco-secretariat']) == (d.role == 'unesco-secretariat') && validGroups(d.wgs) && d.get('badges',[]) is list && d.get('badges',[]).size() <= 20 && d.get('badges',[]).hasOnly(["core","lead","associate","secretariat","wg1-member","wg1-core","wg1-lead","wg1-associate","wg1-secretariat","wg2-member","wg2-core","wg2-lead","wg2-associate","wg2-secretariat","wg3-member","wg3-core","wg3-lead","wg3-associate","wg3-secretariat","wg4-member","wg4-core","wg4-lead","wg4-associate","wg4-secretariat","wg5-member","wg5-core","wg5-lead","wg5-associate","wg5-secretariat","cfd","cfd-core","cfd-lead","cfd-associate","cfd-secretariat","smc","smc-core","smc-lead","smc-associate","smc-secretariat","esc","esc-core","esc-lead","esc-associate","esc-secretariat","alliance","alliance-core","alliance-lead","alliance-associate","alliance-secretariat","iac","iac-core","iac-lead","iac-associate","iac-secretariat","unesco-secretariat"]); }
    function validPreferences(d) { return d.keys().hasAll(['wgs']) && d.keys().hasOnly(['wgs','welcomeSeen']) && validGroups(d.wgs) && d.get('welcomeSeen', false) is bool; }
    // Files shared by the leadership of a body or the UNESCO Secretariat (PDF, Word, PowerPoint), attached to news,
    // events, activities and Working Group discussions. Attachments are checked only when they change.
    function fileType(t) { return t in ['pdf','doc','docx','ppt','pptx']; }
    function fileBody(b) { return (b == '' && admin()) || (validBody(b) && (admin() || leadBody(b))); }
    function validAttachment(a) {
      return a is map && a.keys().hasAll(['id','name','type','size','body']) && a.keys().hasOnly(['id','name','type','size','body'])
        && string(a.id,64) && string(a.name,200) && fileType(a.type) && a.size is int && a.size > 0 && a.size <= 10485760 && fileBody(a.body);
    }
    function attachmentsOk(d) {
      let v = d.get('attachments', []);
      return v == (resource == null ? [] : resource.data.get('attachments', []))
        || (v is list && v.size() <= 5 && (v.size() < 1 || validAttachment(v[0])) && (v.size() < 2 || validAttachment(v[1]))
          && (v.size() < 3 || validAttachment(v[2])) && (v.size() < 4 || validAttachment(v[3])) && (v.size() < 5 || validAttachment(v[4])));
    }
    function validOpportunity(d) {
      return d.keys().hasAll(['owner','wg','title','description','skills','region','language','commitment','deadline','type','status','createdAt'])
        && d.keys().hasOnly(['owner','wg','title','description','skills','region','language','commitment','deadline','type','status','createdAt','mgs','attachments','project'])
        && string(d.get('project',''),128)
        && string(d.owner,128) && d.wg is int && d.wg >= 1 && d.wg <= 5 && string(d.title,160) && d.title.size()>0
        && string(d.description,3000) && d.description.size()>0 && validSkills(d.skills) && validRegion(d.region)
        && string(d.language,100) && d.language.size() > 0 && validTime(d.commitment)
        && string(d.deadline,10) && (d.deadline == '' || d.deadline.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && string(d.type,100) && d.type.size()>0 && validGoals(d.get('mgs',[]))
        && (d.get('mgs',[]).size() == 0 || goalsInGroup(d.mgs,d.wg))
        && d.status in ['pending','open','closed'] && d.createdAt is timestamp && attachmentsOk(d);
    }
    function validContribution(d) {
      return d.keys().hasAll(['opportunity_id','member_id','member_name','opportunity_title','wg','message','status','createdAt','updatedAt'])
        && d.keys().hasOnly(['opportunity_id','member_id','member_name','opportunity_title','wg','message','status','createdAt','updatedAt'])
        && string(d.opportunity_id,128) && string(d.member_id,128) && string(d.member_name,120) && string(d.opportunity_title,160)
        && d.wg is int && d.wg >= 1 && d.wg <= 5 && string(d.message,2000) && d.message.size()>0
        && d.status in ['Interested','Shortlisted','Selected','In progress','Completed','Not selected','Withdrawn'] && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function validPost(d) { return d.keys().hasAll(['author','author_name','wg','body','createdAt']) && d.keys().hasOnly(['author','author_name','wg','body','createdAt','title','url','bodyId','updatedAt','mgs','attachments']) && validGoals(d.get('mgs',[])) && string(d.author,128) && string(d.author_name,120) && d.wg is int && d.wg >= 0 && d.wg <= 5 && string(d.body,3000) && d.body.size()>0 && d.createdAt is timestamp && string(d.get('title',''),160) && safeEventLink(d.get('url','')) && (d.get('bodyId','') == '' || validBody(d.bodyId)) && (!('updatedAt' in d) || d.updatedAt == request.time) && attachmentsOk(d); }
    function safeEventLink(v) { return string(v,1000) && (v == '' || v.matches('^https?://[^\\s]+$')); }
    function validEvent(d) {
      return d.keys().hasAll(['owner','title','description','startAt','endAt','timeZone','location','registrationUrl','joinUrl','ocs','mgs','createdAt','updatedAt'])
        && d.keys().hasOnly(['owner','title','description','startAt','endAt','timeZone','location','registrationUrl','joinUrl','ocs','mgs','createdAt','updatedAt','body','meetingType','pollId','attachments'])
        && string(d.owner,128) && d.owner.size()>0 && string(d.title,160) && d.title.size()>0 && string(d.description,3000)
        && d.startAt is timestamp && d.endAt is timestamp && d.endAt > d.startAt && d.endAt - d.startAt <= duration.value(31,'d')
        && string(d.timeZone,100) && d.timeZone.size()>0 && string(d.location,300)
        && safeEventLink(d.registrationUrl) && safeEventLink(d.joinUrl)
        && validGroups(d.ocs) && d.ocs.size()>0 && d.ocs.toSet().size() == d.ocs.size()
        && d.mgs is list && d.mgs.size()>0 && d.mgs.size()<=15
        && d.mgs.hasOnly(['1.1','1.2','1.3','2.1','2.2','2.3','3.1','3.2','3.3','4.1','4.2','4.3','5.1','5.2','5.3']) && d.mgs.toSet().size() == d.mgs.size()
        && (1 in d.ocs || !d.mgs.hasAny(['1.1','1.2','1.3'])) && (2 in d.ocs || !d.mgs.hasAny(['2.1','2.2','2.3']))
        && (3 in d.ocs || !d.mgs.hasAny(['3.1','3.2','3.3'])) && (4 in d.ocs || !d.mgs.hasAny(['4.1','4.2','4.3']))
        && (5 in d.ocs || !d.mgs.hasAny(['5.1','5.2','5.3']))
        && d.get('meetingType','public') in ['public','leadership','core','broad'] && string(d.get('pollId',''),128)
        && (d.get('meetingType','public') == 'public' ? d.get('body','') == '' && d.get('pollId','') == ''
          : validBody(d.get('body','')) && d.registrationUrl == '' && d.joinUrl == '' && (bodyWg(d.body)==0 || bodyWg(d.body) in d.ocs))
        && d.createdAt is timestamp && d.updatedAt == request.time && attachmentsOk(d);
    }
    match /events/{id} {
      allow read: if signed();
      allow create: if member() && validEvent(request.resource.data) && request.resource.data.owner == request.auth.uid && request.resource.data.createdAt == request.time
        && (request.resource.data.get('meetingType','public') == 'public' || leadBody(request.resource.data.body));
      allow update: if signed() && (admin() || (resource.data.get('meetingType','public') == 'public' ? own(resource.data.owner) : leadBody(resource.data.body))) && validEvent(request.resource.data)
        && request.resource.data.owner == resource.data.owner && request.resource.data.createdAt == resource.data.createdAt
        && (admin() && resource.data.get('pollId','') == '' || (request.resource.data.get('body','') == resource.data.get('body','') && request.resource.data.get('meetingType','public') == resource.data.get('meetingType','public'))) && request.resource.data.get('pollId','') == resource.data.get('pollId','');
      allow delete: if admin() || (resource.data.get('meetingType','public') == 'public' ? own(resource.data.owner) : leadBody(resource.data.body));
      match /meetingDetails/{details} {
        function event() { return get(/databases/$(database)/documents/events/$(id)).data; }
        function afterEvent() { return getAfter(/databases/$(database)/documents/events/$(id)).data; }
        allow read: if signed() && meetingAccess(event().body,event().meetingType);
        allow create,update: if details == 'main' && leadBody(afterEvent().body)
          && request.resource.data.keys().hasOnly(['registrationUrl','joinUrl','updatedAt']) && safeEventLink(request.resource.data.registrationUrl) && safeEventLink(request.resource.data.joinUrl) && request.resource.data.updatedAt == request.time;
        allow delete: if admin() || leadBody(event().body);
      }
      match /agenda/{item} {
        function event() { return get(/databases/$(database)/documents/events/$(id)).data; }
        allow read: if signed() && meetingAccess(event().body,event().meetingType);
        allow create,update: if signed() && agendaEditor(event().body,event().meetingType)
          && request.resource.data.keys().hasAll(['position','title','durationMinutes','presenter','notes','updatedBy','updatedAt'])
          && request.resource.data.keys().hasOnly(['position','title','durationMinutes','presenter','notes','updatedBy','updatedAt'])
          && request.resource.data.position is int && request.resource.data.position>=1 && request.resource.data.position<=100
          && string(request.resource.data.title,160) && request.resource.data.title.size()>0
          && request.resource.data.durationMinutes is int && request.resource.data.durationMinutes>0 && request.resource.data.durationMinutes<=480
          && string(request.resource.data.presenter,120) && string(request.resource.data.notes,3000)
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
        allow delete: if signed() && agendaEditor(event().body,event().meetingType);
      }
    }
    match /profiles/{uid} {
      allow read: if signed() && (own(uid) || admin() || resource.data.visibility == 'community');
      allow create: if (own(uid) || admin()) && request.resource.data.createdAt == request.time && validProfile(request.resource.data);
      allow update: if (own(uid) || admin()) && request.resource.data.createdAt == resource.data.createdAt && validProfile(request.resource.data);
      allow delete: if admin();
    }
    match /privateProfiles/{uid} {
      allow read: if own(uid) || admin();
      allow create, update: if (own(uid) || admin()) && validPrivate(request.resource.data);
      allow delete: if admin();
    }
    // The leadership of a body may add or remove one badge only: the Broad Group badge of that body
    // (wgN-member for a Working Group, the body id for a committee). Everything else on a role stays with the UNESCO Secretariat.
    function broadBadgeChange(changed) {
      return changed.size() == 0
        || (changed.hasOnly(['wg1-member']) && leadBody('wg1')) || (changed.hasOnly(['wg2-member']) && leadBody('wg2'))
        || (changed.hasOnly(['wg3-member']) && leadBody('wg3')) || (changed.hasOnly(['wg4-member']) && leadBody('wg4'))
        || (changed.hasOnly(['wg5-member']) && leadBody('wg5')) || (changed.hasOnly(['cfd']) && leadBody('cfd'))
        || (changed.hasOnly(['alliance']) && leadBody('alliance')) || (changed.hasOnly(['smc']) && leadBody('smc'))
        || (changed.hasOnly(['esc']) && leadBody('esc')) || (changed.hasOnly(['iac']) && leadBody('iac'));
    }
    match /roles/{uid} {
      allow read: if signed();
      allow create: if validRole(request.resource.data) && (admin()
        || (member() && request.resource.data.admin == false && request.resource.data.role == 'member' && request.resource.data.wgs.size() == 0
          && request.resource.data.get('badges',[]).size() == 1 && broadBadgeChange(request.resource.data.badges.toSet())));
      allow update: if validRole(request.resource.data) && (admin()
        || (member() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['badges'])
          && request.resource.data.get('badges',[]).toSet().difference(resource.data.get('badges',[]).toSet()).union(resource.data.get('badges',[]).toSet().difference(request.resource.data.get('badges',[]).toSet())).size() <= 1
          && broadBadgeChange(request.resource.data.get('badges',[]).toSet().difference(resource.data.get('badges',[]).toSet()).union(resource.data.get('badges',[]).toSet().difference(request.resource.data.get('badges',[]).toSet())))));
      allow delete: if admin();
      // A verified login for the Secretariat owner email receives platform access.
    }
    match /preferences/{uid} {
      allow read: if own(uid) || admin();
      allow create, update: if (own(uid) || admin()) && validPreferences(request.resource.data);
      allow delete: if admin();
    }
    match /opportunities/{id} {
      allow read: if signed() && (resource.data.status == 'open' || resource.data.owner == request.auth.uid || manages(resource.data.wg));
      allow create: if member() && validOpportunity(request.resource.data) && request.resource.data.owner == request.auth.uid
        && request.resource.data.get('mgs',[]).size()>0
        && request.resource.data.createdAt == request.time && (request.resource.data.status == 'pending' || (manages(request.resource.data.wg) && request.resource.data.status == 'open'));
      allow update: if signed() && validOpportunity(request.resource.data)
        && request.resource.data.owner == resource.data.owner && request.resource.data.createdAt == resource.data.createdAt
        && (admin() || (manages(resource.data.wg) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','project']))
          // The person who proposed an activity edits its content; its Working Group and status stay as they are.
          || (member() && resource.data.owner == request.auth.uid && request.resource.data.wg == resource.data.wg && request.resource.data.status == resource.data.status));
      allow delete: if admin() || (member() && resource.data.owner == request.auth.uid);
    }
    match /contributions/{id} {
      allow read: if signed() && (resource.data.member_id == request.auth.uid || manages(resource.data.wg));
      allow create: if member() && validContribution(request.resource.data) && id == request.resource.data.opportunity_id + '_' + request.auth.uid
        && request.resource.data.member_id == request.auth.uid && request.resource.data.status == 'Interested'
        && request.resource.data.createdAt == request.time
        && request.resource.data.member_name == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.name
        && request.resource.data.wg == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunity_id)).data.wg
        && request.resource.data.opportunity_title == get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunity_id)).data.title
        && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunity_id)).data.status == 'open';
      allow update: if signed() && validContribution(request.resource.data)
        && request.resource.data.member_id == resource.data.member_id && request.resource.data.opportunity_id == resource.data.opportunity_id && request.resource.data.createdAt == resource.data.createdAt
        && (admin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && ((manages(resource.data.wg) && resource.data.status != 'Withdrawn' && request.resource.data.status != 'Withdrawn')
          || (resource.data.member_id == request.auth.uid && !(resource.data.status in ['Completed','Not selected','Withdrawn']) && request.resource.data.status == 'Withdrawn'))));
      allow delete: if admin();
    }
    match /posts/{id} {
      allow read: if signed();
      allow create: if member() && validPost(request.resource.data) && request.resource.data.author == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.author_name == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.name;
      allow update: if (admin() || own(resource.data.author)) && validPost(request.resource.data) && request.resource.data.author == resource.data.author && request.resource.data.author_name == resource.data.author_name && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if admin() || own(resource.data.author);
      match /comments/{comment} {
        function parentExists() { return exists(/databases/$(database)/documents/posts/$(id)); }
        function validComment(d) { return d.keys().hasAll(['author','author_name','body','createdAt','updatedAt']) && d.keys().hasOnly(['author','author_name','body','createdAt','updatedAt']) && string(d.author,128) && string(d.author_name,120) && string(d.body,1500) && d.body.size()>0 && d.createdAt is timestamp && d.updatedAt == request.time; }
        allow read: if signed() && parentExists();
        allow create: if member() && parentExists() && validComment(request.resource.data) && request.resource.data.author == request.auth.uid && request.resource.data.author_name == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.name && request.resource.data.createdAt == request.time;
        allow update: if parentExists() && (admin() || own(resource.data.author)) && validComment(request.resource.data) && request.resource.data.author == resource.data.author && request.resource.data.author_name == resource.data.author_name && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if admin() || own(resource.data.author);
      }
    }

    // Working Group discussions. Members with a profile read and post under their profile name.
    // Authors edit their own messages; authors, the group's leadership and the Secretariat remove them.
    function discussionSpace(s) { return s in ['wg1','wg2','wg3','wg4','wg5']; }
    function profileName() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.name; }
    function validMentions(v) { return v is list && v.size() <= 20 && v.toSet().size() == v.size() && !(request.auth.uid in v); }
    match /groupDiscussions/{space}/messages/{id} {
      function topicOpen(p) {
        let path = /databases/$(database)/documents/groupDiscussions/$(space)/messages/$(p);
        return exists(path) && get(path).data.parent == '' && get(path).data.deleted == false;
      }
      allow read: if member() && discussionSpace(space);
      allow create: if member() && discussionSpace(space)
        && request.resource.data.keys().hasAll(['space','parent','author','author_name','body','mentions','deleted','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['space','parent','author','author_name','body','mentions','deleted','createdAt','updatedAt','attachments'])
        && attachmentsOk(request.resource.data)
        && request.resource.data.space == space && request.resource.data.author == request.auth.uid && request.resource.data.author_name == profileName()
        && string(request.resource.data.body,3000) && request.resource.data.body.size() > 0 && validMentions(request.resource.data.mentions)
        && request.resource.data.deleted == false && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && (request.resource.data.parent == '' || (string(request.resource.data.parent,128) && topicOpen(request.resource.data.parent)));
      allow update: if signed() && discussionSpace(space)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','mentions','deleted','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && ((own(resource.data.author) && resource.data.deleted == false && request.resource.data.deleted == false
            && string(request.resource.data.body,3000) && request.resource.data.body.size() > 0 && validMentions(request.resource.data.mentions))
          || ((own(resource.data.author) || leadBody(space)) && request.resource.data.deleted == true
            && request.resource.data.body == '' && request.resource.data.mentions.size() == 0));
      allow delete: if discussionSpace(space) && (own(resource.data.author) || leadBody(space));
    }
    // Hub notifications. A member may notify only the people tagged in a discussion message written in the same request.
    match /inbox/{uid}/items/{id} {
      function mentionedIn(d) {
        let m = getAfter(/databases/$(database)/documents/groupDiscussions/$(d.space)/messages/$(d.messageId)).data;
        return m.author == request.auth.uid && uid in m.mentions && m.deleted == false && d.threadId == (m.parent == '' ? d.messageId : m.parent);
      }
      allow read, delete: if own(uid);
      allow update: if own(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read == true;
      allow create: if member() && uid != request.auth.uid
        && request.resource.data.keys().hasAll(['kind','from','from_name','space','messageId','threadId','excerpt','read','createdAt'])
        && request.resource.data.keys().hasOnly(['kind','from','from_name','space','messageId','threadId','excerpt','read','createdAt'])
        && request.resource.data.kind == 'mention' && request.resource.data.from == request.auth.uid && request.resource.data.from_name == profileName()
        && discussionSpace(request.resource.data.space) && string(request.resource.data.messageId,128) && request.resource.data.messageId.size() > 0
        && string(request.resource.data.threadId,128) && string(request.resource.data.excerpt,400)
        && request.resource.data.read == false && request.resource.data.createdAt == request.time
        && mentionedIn(request.resource.data);
    }

    match /profilePhotos/{uid} {
      allow read: if signed() && (own(uid) || admin() || get(/databases/$(database)/documents/profiles/$(uid)).data.visibility == 'community');
      allow create, update: if (own(uid) || admin())
        && request.resource.data.keys().hasAll(['data','updatedAt']) && request.resource.data.keys().hasOnly(['data','updatedAt'])
        && string(request.resource.data.data,100000) && request.resource.data.data.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/profiles/$(uid)).data.hasPhoto == true;
      allow delete: if own(uid) || admin();
    }
    match /categories/{id} {
      allow read: if signed();
      allow create: if signed() && id.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasAll(['kind','label','normalized','enabled','createdBy','createdAt'])
        && request.resource.data.keys().hasOnly(['kind','label','normalized','enabled','createdBy','createdAt'])
        && request.resource.data.kind in ['skills','languages','careerStages','genders','educationLevels','cryosphereTypes','contributionTypes']
        && string(request.resource.data.label,100) && request.resource.data.label.size() > 0
        && string(request.resource.data.normalized,100) && request.resource.data.normalized.size() > 0
        && request.resource.data.enabled == true && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled']) && request.resource.data.enabled is bool;
      allow delete: if admin();
    }
    match /governance/{id} {
      allow read: if signed();
      allow create, update: if admin() && id in ['wg1','wg2','wg3','wg4','wg5','cfd','smc','esc','alliance','iac']
        && request.resource.data.keys().hasAll(['title','description','lead','secretariat','associateLeads','core','updatedAt'])
        && request.resource.data.keys().hasOnly(['title','description','lead','secretariat','associateLeads','core','updatedAt'])
        && string(request.resource.data.title,160) && request.resource.data.title.size() > 0 && string(request.resource.data.description,1500)
        && string(request.resource.data.lead,128) && validList(request.resource.data.secretariat) && validList(request.resource.data.associateLeads) && validList(request.resource.data.core)
        && (!(id in ['esc','smc']) || (request.resource.data.secretariat.size() <= 1
          && request.resource.data.associateLeads.size() <= 1
          && (request.resource.data.lead == '' || !(request.resource.data.lead in request.resource.data.associateLeads))))
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    function validPoll(d) {
      return d.keys().hasAll(['owner','title','body','meetingType','mgs','durationMinutes','slots','deadline','status','selectedSlot','eventId','createdAt','updatedAt'])
        && d.keys().hasOnly(['owner','title','body','meetingType','mgs','durationMinutes','slots','deadline','status','selectedSlot','eventId','createdAt','updatedAt','linkAccess','notes','withdrawn'])
        && d.get('linkAccess',false) is bool && string(d.get('notes',''),1000)
        && d.get('withdrawn',[]) is list && d.get('withdrawn',[]).size() < d.slots.size()
        && string(d.owner,128) && string(d.title,160) && d.title.size()>0 && validBody(d.body) && d.meetingType in ['leadership','core','broad']
        && validGoals(d.mgs) && (bodyWg(d.body)==0 || d.mgs.size()==0 || goalsInGroup(d.mgs,bodyWg(d.body)))
        && d.durationMinutes is int && d.durationMinutes>=15 && d.durationMinutes<=480 && d.slots is list && d.slots.size()>0 && d.slots.size()<=24 && d.slots.toSet().size()==d.slots.size()
        && d.deadline is timestamp && d.status in ['open','closed','scheduled'] && d.selectedSlot is int && string(d.eventId,128)
        && d.createdAt is timestamp && d.updatedAt == request.time
        && (d.slots.size()<=0 || (d.slots[0] is timestamp && d.slots[0] > d.deadline))
        && (d.slots.size()<=1 || (d.slots[1] is timestamp && d.slots[1] > d.deadline))
        && (d.slots.size()<=2 || (d.slots[2] is timestamp && d.slots[2] > d.deadline))
        && (d.slots.size()<=3 || (d.slots[3] is timestamp && d.slots[3] > d.deadline))
        && (d.slots.size()<=4 || (d.slots[4] is timestamp && d.slots[4] > d.deadline))
        && (d.slots.size()<=5 || (d.slots[5] is timestamp && d.slots[5] > d.deadline))
        && (d.slots.size()<=6 || (d.slots[6] is timestamp && d.slots[6] > d.deadline))
        && (d.slots.size()<=7 || (d.slots[7] is timestamp && d.slots[7] > d.deadline))
        && (d.slots.size()<=8 || (d.slots[8] is timestamp && d.slots[8] > d.deadline))
        && (d.slots.size()<=9 || (d.slots[9] is timestamp && d.slots[9] > d.deadline))
        && (d.slots.size()<=10 || (d.slots[10] is timestamp && d.slots[10] > d.deadline))
        && (d.slots.size()<=11 || (d.slots[11] is timestamp && d.slots[11] > d.deadline))
        && (d.status == 'scheduled' ? d.selectedSlot>=0 && d.selectedSlot<d.slots.size() && d.eventId.size()>0 : d.selectedSlot == -1 && d.eventId == '');
    }
    function pollEventMatches(d,id) {
      let e = getAfter(/databases/$(database)/documents/events/$(d.eventId)).data;
      return e.body == d.body && e.meetingType == d.meetingType && e.pollId == id && e.startAt == d.slots[d.selectedSlot] && e.endAt - e.startAt == duration.value(d.durationMinutes,'m');
    }
    // linkAccess: the organiser lets anyone signed in who holds the poll link (its unguessable id) open and answer it.
    // It never makes polls listable.
    function pollLinkOpen(p) { return p.get('linkAccess',false) == true; }
    match /meetingPolls/{id} {
      allow get: if signed() && (admin() || !exists(/databases/$(database)/documents/meetingPolls/$(id)) || meetingAccess(resource.data.body,resource.data.meetingType) || pollLinkOpen(resource.data));
      allow list: if signed() && (admin() || meetingAccess(resource.data.body,resource.data.meetingType));
      allow create: if member() && leadBody(request.resource.data.body) && validPoll(request.resource.data) && request.resource.data.slots.size() <= 12
        && request.resource.data.get('withdrawn',[]).size() == 0 && request.resource.data.owner == request.auth.uid && request.resource.data.createdAt == request.time && request.resource.data.deadline > request.time && request.resource.data.status == 'open';
      allow update: if leadBody(resource.data.body) && validPoll(request.resource.data)
        && request.resource.data.owner == resource.data.owner && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.body == resource.data.body && request.resource.data.meetingType == resource.data.meetingType && request.resource.data.durationMinutes == resource.data.durationMinutes
        // Times can be added to an open poll, never removed or replaced, so earlier answers keep their meaning; withdrawn times stay listed.
        && (request.resource.data.slots == resource.data.slots
          || (resource.data.status == 'open' && request.resource.data.slots.size() >= resource.data.slots.size() && request.resource.data.slots.hasAll(resource.data.slots)))
        && (request.resource.data.status != 'scheduled' || pollEventMatches(request.resource.data,id));
      allow delete: if admin();
    }
    match /pollResponses/{id} {
      function poll() { return get(/databases/$(database)/documents/meetingPolls/$(resource.data.pollId)).data; }
      function incomingPoll() { return get(/databases/$(database)/documents/meetingPolls/$(request.resource.data.pollId)).data; }
      allow read: if signed() && (own(resource.data.uid) || meetingAccess(poll().body,poll().meetingType) || pollLinkOpen(poll()));
      // Members answer under their profile name. Through an open poll link, a signed-in person without a profile gives a name.
      allow create,update: if signed() && request.resource.data.keys().hasAll(['pollId','uid','name','timeZone','answers','updatedAt'])
        && request.resource.data.keys().hasOnly(['pollId','uid','name','timeZone','answers','updatedAt'])
        && request.resource.data.uid == request.auth.uid && id == request.resource.data.pollId+'_'+request.auth.uid
        && string(request.resource.data.name,120) && request.resource.data.name.size()>0
        && (member() ? request.resource.data.name == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.name : pollLinkOpen(incomingPoll()))
        && string(request.resource.data.timeZone,100) && request.resource.data.timeZone.size()>0
        && request.resource.data.answers is list && request.resource.data.answers.size() == incomingPoll().slots.size() && request.resource.data.answers.hasOnly(['yes','if-needed','no'])
        && incomingPoll().status == 'open' && incomingPoll().deadline > request.time && (meetingAccess(incomingPoll().body,incomingPoll().meetingType) || pollLinkOpen(incomingPoll()))
        && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }
    match /meetingClocks/{body} {
      allow read: if signed();
      allow create: if leadBody(body) && body in ['wg1','wg2','wg3','wg4','wg5','cfd','alliance'] && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
      allow update,delete: if false;
    }
    // Logo review access is granted member by member by the UNESCO Secretariat (roles/{uid}.logoReview), not by appointments.
    function logoBody(b) { return b in ['WG1','WG2','WG3','WG4','WG5','SMC','ESC'] && signed()
      && (admin() || (roleExists() && b.lower() in roleData().get('logoReview', []))); }
    function logoRead(d) { return admin()
        || ('WG1' in d.assigned.bodies && logoBody('WG1'))
        || ('WG2' in d.assigned.bodies && logoBody('WG2'))
        || ('WG3' in d.assigned.bodies && logoBody('WG3'))
        || ('WG4' in d.assigned.bodies && logoBody('WG4'))
        || ('WG5' in d.assigned.bodies && logoBody('WG5'))
        || ('CFD' in d.assigned.bodies && logoBody('CFD'))
        || ('ALLIANCE' in d.assigned.bodies && logoBody('ALLIANCE'))
        || ('SMC' in d.assigned.bodies && logoBody('SMC'))
        || ('ESC' in d.assigned.bodies && logoBody('ESC'))
        || ('IAC' in d.assigned.bodies && logoBody('IAC'))
      ;
    }
    match /logoRequests/{ref} { allow read: if signed() && logoRead(resource.data); allow write: if admin(); }
    match /logoContacts/{ref} { allow read,write: if admin(); }
    match /logoReviews/{id} {
      function parent() { return get(/databases/$(database)/documents/logoRequests/$(resource.data.ref)).data; }
      function validOpinion(d) { return d.keys().hasAll(['uid','key','ref','body','reviewer','createdAt','updatedAt'])
        && d.keys().hasOnly(['uid','key','ref','body','reviewer','createdAt','updatedAt','account','label','opinion','text','conditions','status','submittedAt'])
        && string(d.uid,128) && string(d.key,240) && string(d.ref,128) && string(d.body,20) && string(d.reviewer,120) && string(d.get('opinion',''),100) && string(d.get('text',''),6000) && string(d.get('conditions',''),3000)
        && string(d.createdAt,40) && string(d.updatedAt,40) && d.get('status','draft') in ['draft','submitted']; }
      allow read: if signed() && (admin() || logoRead(parent()));
      allow create: if admin() || (signed() && validOpinion(request.resource.data) && request.resource.data.uid == request.auth.uid && id == request.auth.uid+'__'+request.resource.data.key
        && logoBody(request.resource.data.body) && request.resource.data.body in get(/databases/$(database)/documents/logoRequests/$(request.resource.data.ref)).data.assigned.bodies);
      allow update: if admin() || (own(resource.data.uid) && validOpinion(request.resource.data) && request.resource.data.uid == resource.data.uid && request.resource.data.key == resource.data.key && request.resource.data.ref == resource.data.ref && request.resource.data.body == resource.data.body
        && logoBody(resource.data.body) && resource.data.body in parent().assigned.bodies);
      allow delete: if admin() || (own(resource.data.uid) && logoBody(resource.data.body) && resource.data.body in parent().assigned.bodies);
    }
    function logoCodeOk(d) { return string(d.ref,128) && string(d.code,100) && exists(/databases/$(database)/documents/logoReportCodes/$(d.ref)) && get(/databases/$(database)/documents/logoReportCodes/$(d.ref)).data.code == d.code; }
    function optLogoStr(d,k,n) { return !(k in d) || string(d[k],n); }
    function validLogoReport(d) { return d.keys().hasOnly(['ref','code','type','periodFrom','periodTo','name','email','organisation','status','logoUse','summary','outcomes','people','outputs','countries','mgs','contribution','links','fileName','fileSize','consent','submittedAt'])
      && d.type in ['Progress update','Final report'] && string(d.name,120) && d.name.size()>0 && string(d.email,160) && string(d.summary,4000) && d.summary.size()>0
      && optLogoStr(d,'organisation',200) && optLogoStr(d,'status',60) && optLogoStr(d,'logoUse',500) && optLogoStr(d,'outcomes',4000) && optLogoStr(d,'countries',500) && optLogoStr(d,'contribution',3000) && optLogoStr(d,'periodFrom',10) && optLogoStr(d,'periodTo',10)
      && (!( 'mgs' in d) || (d.mgs is list && d.mgs.size()<=15)) && (!( 'links' in d) || (d.links is list && d.links.size()<=20)) && d.consent == true && d.submittedAt == request.time;
    }
    match /logoReportCodes/{ref} { allow read,write: if admin(); }
    match /logoReports/{id} { allow create: if validLogoReport(request.resource.data) && logoCodeOk(request.resource.data); allow read,update,delete: if admin(); }
    match /logoReportFiles/{id} {
      allow create: if request.resource.data.keys().hasOnly(['ref','code','name','type','size','data','submittedAt']) && string(request.resource.data.data,980000) && request.resource.data.size is int && request.resource.data.size<=716800 && request.resource.data.submittedAt == request.time
        && exists(/databases/$(database)/documents/logoReports/$(id)) && get(/databases/$(database)/documents/logoReports/$(id)).data.ref == request.resource.data.ref && logoCodeOk(request.resource.data);
      allow read,delete: if admin();
    }
    // ===== Version 3.12: minutes, actions, work plans, decisions and consultations =====
    function ymdOrEmpty(v) { return v is string && (v == '' || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function eventData(id) { return get(/databases/$(database)/documents/events/$(id)).data; }
    // Public events: minutes and actions are read by all signed-in members and written by the organiser or the Secretariat.
    function notesReader(e) { return e.get('meetingType','public') == 'public' ? signed() : meetingAccess(e.get('body',''), e.meetingType); }
    function notesEditor(e) { return e.get('meetingType','public') == 'public' ? (signed() && (admin() || e.owner == request.auth.uid)) : agendaEditor(e.get('body',''), e.meetingType); }

    // Minutes of a meeting: read by its audience, written by those who edit its agenda.
    match /events/{id}/meetingNotes/{note} {
      allow read: if signed() && notesReader(eventData(id));
      allow create, update: if note == 'minutes' && signed() && notesEditor(eventData(id))
        && request.resource.data.keys().hasAll(['summary','decisions','updatedBy','updatedAt'])
        && request.resource.data.keys().hasOnly(['summary','decisions','updatedBy','updatedAt'])
        && string(request.resource.data.summary,20000) && string(request.resource.data.decisions,10000)
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if signed() && (admin() || notesEditor(eventData(id)));
    }

    // Action items from a meeting. The person responsible can read and tick their own action.
    function validAction(d) {
      return d.keys().hasAll(['eventId','body','meetingType','title','owner','owner_name','due','status','createdBy','createdAt','updatedAt'])
        && d.keys().hasOnly(['eventId','body','meetingType','title','owner','owner_name','due','status','createdBy','createdAt','updatedAt'])
        && string(d.eventId,128) && d.eventId.size() > 0
        && ((d.meetingType == 'public' && d.body == '') || (validBody(d.body) && d.meetingType in ['leadership','core','broad']))
        && string(d.title,300) && d.title.size() > 0 && string(d.owner,128) && string(d.owner_name,120)
        && ymdOrEmpty(d.due) && d.status in ['open','done'] && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /actions/{id} {
      allow read: if signed() && (resource.data.owner == request.auth.uid || resource.data.meetingType == 'public' || meetingAccess(resource.data.body, resource.data.meetingType));
      allow create: if signed() && validAction(request.resource.data) && notesEditor(eventData(request.resource.data.eventId))
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time
        && eventData(request.resource.data.eventId).get('body','') == request.resource.data.body
        && eventData(request.resource.data.eventId).get('meetingType','public') == request.resource.data.meetingType;
      allow update: if signed() && validAction(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','owner','owner_name','due','status','updatedAt'])
        && (notesEditor(eventData(resource.data.eventId))
          || (resource.data.owner == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])));
      allow delete: if signed() && notesEditor(eventData(resource.data.eventId));
    }

    // Sign-ups for an event: each member records their own attendance (in person or online). Members who can see
    // the event see who attends; the organisers and the UNESCO Secretariat can also remove a sign-up.
    match /events/{id}/attendance/{uid} {
      allow read: if member() && notesReader(eventData(id));
      allow create, update: if own(uid) && member() && notesReader(eventData(id))
        && request.resource.data.keys().hasAll(['name','mode','at']) && request.resource.data.keys().hasOnly(['name','mode','at'])
        && request.resource.data.name == profileName() && request.resource.data.mode in ['in-person','online']
        && request.resource.data.at == request.time && eventData(id).endAt > request.time;
      allow delete: if own(uid) || admin() || notesEditor(eventData(id));
    }

    // Task boards of the leadership and Core Group of each body. People assigned to a task can read it, move it
    // between columns and mark it as seen, even without a Core Group role.
    function validTask(d) {
      return d.keys().hasAll(['body','title','notes','status','priority','assignees','seenBy','due','createdBy','createdAt','updatedBy','updatedAt'])
        && d.keys().hasOnly(['body','title','notes','status','priority','assignees','seenBy','due','createdBy','createdAt','updatedBy','updatedAt'])
        && validBody(d.body) && string(d.title,200) && d.title.size() > 0 && string(d.notes,3000)
        && d.status in ['todo','doing','done'] && d.priority in ['normal','high']
        && d.assignees is list && d.assignees.size() <= 10 && d.assignees.toSet().size() == d.assignees.size()
        && d.seenBy is list && d.seenBy.size() <= 10 && ymdOrEmpty(d.due)
        && string(d.createdBy,128) && d.createdAt is timestamp && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    match /tasks/{id} {
      allow read: if signed() && !banned(request.auth.uid) && (request.auth.uid in resource.data.assignees || coreBody(resource.data.body));
      allow create: if member() && coreBody(request.resource.data.body) && validTask(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if member() && validTask(request.resource.data) && request.resource.data.body == resource.data.body
        && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
        && (coreBody(resource.data.body)
          || (request.auth.uid in resource.data.assignees
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','seenBy','updatedBy','updatedAt'])
            && request.resource.data.seenBy.toSet().difference(resource.data.seenBy.toSet()).hasOnly([request.auth.uid])
            && resource.data.seenBy.toSet().difference(request.resource.data.seenBy.toSet()).size() == 0));
      allow delete: if leadBody(resource.data.body) || (coreBody(resource.data.body) && resource.data.createdBy == request.auth.uid);
    }

    // Work plan of each Working Group, linked to one of its main goals. Members read; leadership and Core Group edit.
    function validWorkItem(d) {
      return d.keys().hasAll(['body','kind','title','mg','due','status','lead','notes','updatedBy','createdAt','updatedAt'])
        && d.keys().hasOnly(['body','kind','title','mg','due','status','lead','notes','updatedBy','createdAt','updatedAt','parent'])
        && d.body in ['wg1','wg2','wg3','wg4','wg5'] && d.kind in ['deliverable','milestone'] && string(d.get('parent',''),128)
        && string(d.title,200) && d.title.size() > 0 && d.mg is string && validGoals([d.mg]) && goalsInGroup([d.mg], bodyWg(d.body))
        && ymdOrEmpty(d.due) && d.status in ['planned','in-progress','delayed','done'] && string(d.lead,160) && string(d.notes,1000)
        && d.updatedBy == request.auth.uid && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /workplanItems/{id} {
      allow read: if member() || admin();
      allow create: if coreBody(request.resource.data.body) && validWorkItem(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if coreBody(resource.data.body) && validWorkItem(request.resource.data)
        && request.resource.data.body == resource.data.body && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if coreBody(resource.data.body);
    }

    // Decision register of the SMC and ESC. "body" entries are read by members of that body; "community" entries by all members.
    function validDecision(d) {
      return d.keys().hasAll(['body','date','reference','title','text','eventId','visibility','createdBy','createdAt','updatedBy','updatedAt'])
        && d.keys().hasOnly(['body','date','reference','title','text','eventId','visibility','createdBy','createdAt','updatedBy','updatedAt'])
        && d.body in ['smc','esc'] && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && string(d.reference,60) && string(d.title,200) && d.title.size() > 0 && string(d.text,5000) && string(d.eventId,128)
        && d.visibility in ['body','community'] && d.createdAt is timestamp && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
    }
    match /decisions/{id} {
      allow read: if signed() && (admin() || bodyMember(resource.data.body) || (resource.data.visibility == 'community' && member()));
      allow create: if leadBody(request.resource.data.body) && validDecision(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow update: if leadBody(resource.data.body) && validDecision(request.resource.data) && request.resource.data.body == resource.data.body
        && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if leadBody(resource.data.body);
    }

    // Consultations: yes/no votes and short surveys for a body's audience.
    function validConsultation(d) {
      return d.keys().hasAll(['owner','body','audience','title','description','questions','deadline','status','resultsVisible','createdAt','updatedAt'])
        && d.keys().hasOnly(['owner','body','audience','title','description','questions','deadline','status','resultsVisible','createdAt','updatedAt'])
        && string(d.owner,128) && validBody(d.body) && d.audience in ['leadership','core','broad']
        && string(d.title,160) && d.title.size() > 0 && string(d.description,3000)
        && d.questions is list && d.questions.size() > 0 && d.questions.size() <= 10
        && d.deadline is timestamp && d.status in ['open','closed'] && d.resultsVisible is bool
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /consultations/{id} {
      allow read: if signed() && (admin() || meetingAccess(resource.data.body, resource.data.audience));
      allow create: if member() && leadBody(request.resource.data.body) && validConsultation(request.resource.data)
        && request.resource.data.owner == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.deadline > request.time && request.resource.data.status == 'open';
      allow update: if leadBody(resource.data.body) && validConsultation(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','deadline','status','resultsVisible','updatedAt']);
      allow delete: if leadBody(resource.data.body);
      match /answers/{uid} {
        function consultation() { return get(/databases/$(database)/documents/consultations/$(id)).data; }
        allow read: if own(uid) || leadBody(consultation().body)
          || (consultation().resultsVisible == true && meetingAccess(consultation().body, consultation().audience));
        allow create, update: if own(uid) && member() && meetingAccess(consultation().body, consultation().audience)
          && consultation().status == 'open' && consultation().deadline > request.time
          && request.resource.data.keys().hasAll(['name','answers','updatedAt']) && request.resource.data.keys().hasOnly(['name','answers','updatedAt'])
          && request.resource.data.name == profileName()
          && request.resource.data.answers is map && request.resource.data.answers.size() > 0 && request.resource.data.answers.size() <= 10
          && string(request.resource.data.answers.values().join('\n'), 20000)
          && request.resource.data.updatedAt == request.time;
        allow delete: if own(uid) || admin();
      }
    }

    // Membership totals published by the UNESCO Secretariat (gender and professional experience as totals only).
    match /communityStats/{id} {
      allow read: if member() || admin();
      allow create, update: if admin() && id == 'members'
        && request.resource.data.keys().hasAll(['total','gender','careerStage','updatedAt']) && request.resource.data.keys().hasOnly(['total','gender','careerStage','updatedAt'])
        && request.resource.data.total is int && request.resource.data.gender is map && request.resource.data.gender.size() <= 30
        && request.resource.data.careerStage is map && request.resource.data.careerStage.size() <= 30 && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }

    // Mailing lists. Each member keeps their own entry (name, sign-in email, tier) in the list of every body they
    // belong to and in the Decade-wide list. A member can only claim a tier they hold. The leadership and Core Group
    // of a body read its list; only the UNESCO Secretariat reads the Decade-wide list.
    match /mailingLists/{list}/entries/{uid} {
      function validEntry(d) {
        return d.keys().hasAll(['name','email','tier','updatedAt']) && d.keys().hasOnly(['name','email','tier','updatedAt'])
          && string(d.name,120) && string(d.email,254) && d.email.matches('^[^@\\s]+@[^@\\s]+$') && d.updatedAt == request.time
          && (list == 'decade' ? d.tier == 'member' : (validBody(list) && d.tier in ['leadership','core','broad']));
      }
      // Broad Group lists: only members certified by the UNESCO Secretariat with the body's Broad Group badge (or a higher role).
      function certified(b) { return coreBody(b) || (roleExists() && roleData().get('badges',[]).hasAny([b, b+'-member'])); }
      function holdsTier(t) { return list == 'decade' || (t == 'leadership' ? leadBody(list) : t == 'core' ? coreBody(list) : certified(list)); }
      // Read by the member, the UNESCO Secretariat and the leadership of the body (not by its Core Group).
      allow read: if own(uid) || admin() || (list != 'decade' && leadBody(list));
      allow create, update: if validEntry(request.resource.data) && (admin()
        || (own(uid) && member() && request.resource.data.email == request.auth.token.email && holdsTier(request.resource.data.tier)));
      allow delete: if own(uid) || admin();
    }

    // Applications to join the Broad Group of a Working Group: sent by the member, decided by the leadership of the group
    // or the UNESCO Secretariat. Approval adds the Broad Group badge to the member's role (see roles above).
    match /groupApplications/{id} {
      // A member may look up their own application before it exists (the app checks it before applying).
      allow get: if signed() && (resource == null ? id.matches('^(wg[1-5]|cfd|alliance|smc|esc|iac)_' + request.auth.uid + '$')
        : (resource.data.uid == request.auth.uid || admin() || leadBody(resource.data.body)));
      allow list: if signed() && (resource.data.uid == request.auth.uid || admin() || leadBody(resource.data.body));
      allow create: if member() && validBody(request.resource.data.body) && id == request.resource.data.body + '_' + request.auth.uid
        && request.resource.data.keys().hasAll(['uid','name','body','status','createdAt','decidedBy','decidedAt'])
        && request.resource.data.keys().hasOnly(['uid','name','body','status','createdAt','decidedBy','decidedAt'])
        && request.resource.data.uid == request.auth.uid && request.resource.data.name == profileName()
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && request.resource.data.decidedBy == '' && request.resource.data.decidedAt == null;
      allow update: if (member() && resource.data.uid == request.auth.uid && resource.data.status == 'declined'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','status','createdAt','decidedBy','decidedAt'])
          && request.resource.data.name == profileName() && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
          && request.resource.data.decidedBy == '' && request.resource.data.decidedAt == null)
        || ((admin() || leadBody(resource.data.body))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','decidedBy','decidedAt'])
          && request.resource.data.status in ['approved','declined'] && request.resource.data.decidedBy == request.auth.uid && request.resource.data.decidedAt == request.time);
      allow delete: if signed() && (resource.data.uid == request.auth.uid || admin());
    }

    // Roles declared by members at registration, confirmed, adjusted or declined by the UNESCO Secretariat.
    function requestBodies() { return ['wg1','wg2','wg3','wg4','wg5','cfd','alliance','smc','esc','iac']; }
    function validRoleRequest(d) {
      return d.keys().hasAll(['name','claims','note','decisions','status','updatedAt']) && d.keys().hasOnly(['name','claims','note','decisions','status','updatedAt','reviewedAt'])
        && string(d.name,120) && string(d.note,1000)
        && d.claims is map && d.claims.keys().hasOnly(requestBodies()) && d.claims.values().hasOnly(['lead','associate','secretariat','core','member','unsure','apply'])
        && d.decisions is map && d.decisions.keys().hasOnly(requestBodies()) && d.decisions.values().hasOnly(['lead','associate','secretariat','core','member','declined'])
        && d.status in ['pending','reviewed'] && d.updatedAt == request.time;
    }
    match /roleRequests/{uid} {
      allow read: if own(uid) || admin();
      allow create: if own(uid) && validRoleRequest(request.resource.data) && request.resource.data.decisions.size() == 0
        && request.resource.data.status == 'pending' && !('reviewedAt' in request.resource.data);
      allow update: if (admin() && validRoleRequest(request.resource.data))
        || (own(uid) && validRoleRequest(request.resource.data) && request.resource.data.status == 'pending'
          && (request.resource.data.decisions == resource.data.decisions || request.resource.data.decisions.size() == 0)
          && request.resource.data.get('reviewedAt', null) == resource.data.get('reviewedAt', null));
      allow delete: if own(uid) || admin();
    }

    // Private conversations between two members. Moderators — the owner account and the members it appoints in
    // config/chatMonitors — can read every conversation, remove a message and handle reports.
    function chatMonitor() {
      let path = /databases/$(database)/documents/config/chatMonitors;
      return secretariatOwner() || (signed() && exists(path) && get(path).data.uids.hasAny([request.auth.uid]));
    }
    function chatPreview(m) { return m is map && m.keys().hasAll(['text','from','at']) && m.keys().hasOnly(['text','from','at']) && string(m.text,200) && m.from == request.auth.uid && m.at == request.time; }
    function directChat(d, id) {
      return d.keys().hasAll(['members','names','createdAt','updatedAt','lastMessage','lastRead'])
        && d.keys().hasOnly(['members','names','createdAt','updatedAt','lastMessage','lastRead'])
        && d.members is list && d.members.size() == 2 && d.members[0] < d.members[1] && request.auth.uid in d.members
        && id == d.members[0] + '_' + d.members[1]
        && d.names is map && d.names.keys().hasOnly(d.members) && d.names.size() <= 2
        && d.createdAt == request.time && d.updatedAt == request.time && chatPreview(d.lastMessage)
        && d.lastRead is map && d.lastRead.keys().hasOnly([request.auth.uid]);
    }
    function groupMembers(d) {
      return d.members is list && d.members.size() >= 2 && d.members.size() <= 30 && d.members.toSet().size() == d.members.size()
        && string(d.title,80) && d.title.size() > 0 && d.names is map && d.names.keys().hasOnly(d.members);
    }
    function groupChat(d) {
      return d.keys().hasAll(['kind','title','createdBy','members','names','createdAt','updatedAt','lastMessage','lastRead'])
        && d.keys().hasOnly(['kind','title','createdBy','members','names','createdAt','updatedAt','lastMessage','lastRead'])
        && d.kind == 'group' && d.createdBy == request.auth.uid && request.auth.uid in d.members && d.members.size() >= 3 && groupMembers(d)
        && d.createdAt == request.time && d.updatedAt == request.time && chatPreview(d.lastMessage)
        && d.lastRead is map && d.lastRead.keys().hasOnly([request.auth.uid]);
    }
    match /config/chatMonitors {
      allow read: if signed();
      allow write: if secretariatOwner() && request.resource.data.keys().hasAll(['uids','updatedAt']) && request.resource.data.keys().hasOnly(['uids','updatedAt'])
        && request.resource.data.uids is list && request.resource.data.uids.size() <= 20 && request.resource.data.updatedAt == request.time;
    }
    match /chats/{chatId} {
      // Reading a conversation that does not exist yet only reveals that it does not exist.
      allow get: if signed() && (resource == null || request.auth.uid in resource.data.members || chatMonitor());
      allow list: if signed() && (request.auth.uid in resource.data.members || chatMonitor());
      // A conversation between two members has a fixed id (both ids, sorted); a group has any id.
      allow create: if member() && (directChat(request.resource.data, chatId) || groupChat(request.resource.data));
      // A member records a new message (preview and time) and their own reading time only. In a group, the creator
      // renames it or changes its members (staying in it), and any member can leave.
      allow update: if signed() && !banned(request.auth.uid) && request.auth.uid in resource.data.members && (
        (request.resource.data.lastRead is map && request.resource.data.lastRead.diff(resource.data.lastRead).affectedKeys().hasOnly([request.auth.uid])
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastRead'])
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt','lastRead'])
              && chatPreview(request.resource.data.lastMessage) && request.resource.data.updatedAt == request.time)))
        || (resource.data.get('kind','') == 'group' && resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','members','names'])
          && groupMembers(request.resource.data) && request.auth.uid in request.resource.data.members)
        || (resource.data.get('kind','') == 'group'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','names','lastRead'])
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
          && request.resource.data.names.keys().hasOnly(request.resource.data.members)
          && request.resource.data.lastRead.diff(resource.data.lastRead).affectedKeys().hasOnly([request.auth.uid])));
      allow delete: if false;
      match /messages/{id} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        allow read: if signed() && (chatMonitor() || request.auth.uid in chat().members);
        allow create: if signed() && !banned(request.auth.uid) && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.keys().hasAll(['from','text','createdAt']) && request.resource.data.keys().hasOnly(['from','text','createdAt'])
          && request.resource.data.from == request.auth.uid && string(request.resource.data.text,4000) && request.resource.data.text.size() > 0
          && request.resource.data.createdAt == request.time;
        // Moderators remove the text of a message; the record that a message was removed stays.
        allow update: if chatMonitor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','removed','removedBy'])
          && request.resource.data.text == '' && request.resource.data.removed == true && request.resource.data.removedBy == request.auth.uid;
        allow delete: if false;
      }
    }
    match /chatReports/{id} {
      allow read: if chatMonitor() || (signed() && resource.data.reporter == request.auth.uid);
      allow create: if member()
        && request.resource.data.keys().hasAll(['chatId','messageId','reporter','reporterName','reason','status','createdAt'])
        && request.resource.data.keys().hasOnly(['chatId','messageId','reporter','reporterName','reason','status','createdAt'])
        && string(request.resource.data.chatId,260) && string(request.resource.data.messageId,128)
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.members
        && request.resource.data.reporter == request.auth.uid && request.resource.data.reporterName == profileName()
        && string(request.resource.data.reason,1000) && request.resource.data.reason.size() > 0
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time;
      allow update: if chatMonitor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolution','resolvedBy','resolvedAt'])
        && request.resource.data.status in ['open','resolved'] && string(request.resource.data.get('resolution',''),1000)
        && request.resource.data.resolvedBy == request.auth.uid && request.resource.data.resolvedAt == request.time;
      allow delete: if false;
    }

    match /files/{fileId} {
      function canRead(f) { return admin() || (member() && (f.audience == 'all' || meetingAccess(f.body, f.audience))); }
      allow read: if canRead(resource.data);
      allow create: if member()
        && request.resource.data.keys().hasAll(['name','type','size','chunks','body','audience','uploadedBy','createdAt'])
        && request.resource.data.keys().hasOnly(['name','type','size','chunks','body','audience','uploadedBy','createdAt'])
        && string(request.resource.data.name,200) && request.resource.data.name.size() > 0 && fileType(request.resource.data.type)
        && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 10485760
        && request.resource.data.chunks is int && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 20
        && fileBody(request.resource.data.body) && request.resource.data.audience in ['all','leadership','core','broad']
        && (request.resource.data.audience == 'all' || validBody(request.resource.data.body))
        && request.resource.data.uploadedBy == request.auth.uid && request.resource.data.createdAt == request.time;
      allow delete: if signed() && (resource.data.uploadedBy == request.auth.uid || admin());
      match /chunks/{n} {
        function meta() { return get(/databases/$(database)/documents/files/$(fileId)).data; }
        allow read: if canRead(meta());
        allow create: if signed() && meta().uploadedBy == request.auth.uid && n.matches('^[0-9]{1,2}$') && int(n) < meta().chunks
          && request.resource.data.keys().hasOnly(['data']) && request.resource.data.data is string && request.resource.data.data.size() <= 950000;
        allow delete: if signed() && (meta().uploadedBy == request.auth.uid || admin());
      }
    }

    // Members banned by the UNESCO Secretariat. Readable by signed-in members so that banned profiles can be hidden.
    match /bans/{uid} {
      allow read: if signed();
      allow create, update: if admin() && request.resource.data.keys().hasAll(['by','at']) && request.resource.data.keys().hasOnly(['by','at'])
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time && uid != request.auth.uid;
      allow delete: if admin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
